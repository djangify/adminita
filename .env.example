# Copy to .env (never commit .env). Used only by the demo project in config/.
# Generate a key with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=change-me
# Local demo defaults. Set DEBUG=False and a real ALLOWED_HOSTS before exposing it anywhere.
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
